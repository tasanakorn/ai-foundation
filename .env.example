# Local development environment.
#   cp .env.example .env      (.env is gitignored; never commit real keys)
# Read by scripts/dev.py (make dev) and deploy/local/compose.yaml (make services-up).
# Variables already set in your shell win over this file.

# ---- Upstream LLMs ----------------------------------------------------------
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Anthropic: https://platform.claude.com/settings/keys
# Use a key from the Console org linked to your Max, Ultra or Team plan to spend its monthly API credits.
ANTHROPIC_API_KEY=

# llama.cpp (native llama-server, started by make dev when one of these is set)
LLAMA_MODEL=                     # path to a .gguf file
LLAMA_HF=                        # or a Hugging Face repo, e.g. ggml-org/gemma-3-1b-it-GGUF
LLAMA_ARGS=--embeddings --pooling mean -c 4096
# LLAMACPP_URL=http://127.0.0.1:8090/v1   # point at another llama-server instead

# ---- Gateway ----------------------------------------------------------------
AIF_MASTER_KEY=dev-master-key-0000       # optional bearer token for admin API scripts (min 16 chars); dev value, refused outside dev_mode
AIF_ADMIN_EMAIL=admin@example.com       # the local admin account (break-glass), the only one with a password
AIF_ADMIN_PASSWORD=dev-admin-password   # min 12 chars; read on every start; dev value, refused outside dev_mode
# AIF_ADMIN_PASSWORD_HASH='$argon2id$...' # production: instead of AIF_ADMIN_PASSWORD; make it with `aif admin hash-password`
# AIF_OIDC_SSO_SECRET=                    # client secret of an OIDC provider in admin.oidc (one per provider)
# AIF_LISTEN=127.0.0.1:8080              # public API listener
# AIF_ADMIN_LISTEN=0.0.0.0:8081          # admin API + UI; default 127.0.0.1:8081 (local only), "off" disables
# AIF_ANTHROPIC_PREFIX=/anthropic        # Anthropic API path on the public listener; "" turns it off there
# AIF_ANTHROPIC_LISTEN=127.0.0.1:8082     # optional own port for the Anthropic API (at its root); default off
# AIF_TRUSTED_PROXIES=10.0.0.0/8         # proxies allowed to set the client IP header (comma list); default none
# AIF_CLIENT_IP_HEADER=X-Forwarded-For    # header with the client IP; e.g. CF-Connecting-IP behind Cloudflare
# AIF_METRICS_LISTEN=127.0.0.1:9090       # Prometheus /metrics listener; dev default 127.0.0.1:9090, else off
# AIF_CATALOG_MODE=database               # catalog source: database (file seeds it once) or file (file wins, GitOps); dev default file
# AIF_CATALOG_SECRET_KEY=                 # base64 of 32 random bytes (openssl rand -base64 32); encrypts provider keys stored in the database
# AIF_LOG_FORMAT=json

# ---- Backing services (deploy/local/compose.yaml) ---------------------------
POSTGRES_USER=aif
POSTGRES_PASSWORD=aif-dev
POSTGRES_DB=aif
POSTGRES_PORT=5432
DATABASE_URL=postgres://aif:aif-dev@127.0.0.1:5432/aif?sslmode=disable   # required by the gateway
# AIF_TEST_PG_URL=$DATABASE_URL         # Go tests: use this server instead of an embedded Postgres

NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://127.0.0.1:4222             # required by the gateway
# NATS_CREDS=/path/to/user.creds            # optional, for a secured NATS
